//@version=6
// Pine Script v6 Realistic Backtest
// Blog eşliği: execution model, emir dolumu, komisyon, slippage,
// repaint/lookahead engeli, risk bazlı pozisyon, sağlamlık ve forward test.

strategy(
     title              = "Pine Script v6 Realistic Backtest",
     shorttitle         = "PS6-RBT",
     overlay            = true,
     initial_capital    = 10000,
     currency           = currency.USD,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 10,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.075,
     slippage           = 2,
     process_orders_on_close = false,
     calc_on_every_tick = false,
     calc_on_order_fills = false,
     pyramiding         = 0,
     margin_long        = 100,
     margin_short       = 100,
     max_labels_count   = 50)

// ─── 1) Execution model ─────────────────────────────────────────────────────
// Varsayılan: tarihsel barlarda kapalı mumda 1 hesaplama.
// calc_on_every_tick / calc_on_order_fills kapalı → backtest ile canlı daha yakın.
// Market emirleri genelde bir sonraki barın açılışında doldurulur
// (process_orders_on_close = false).

grpExec = "1 · Execution Model"
useConfirmed = input.bool(true, "Yalnız kapalı mumda sinyal", group=grpExec,
     tooltip="barstate.isconfirmed — açık mumda değişen sinyali engeller.")
// process_orders_on_close = false → market emir bir sonraki bar açılışında dolar.
// Karşılaştırma için Properties → “Fill orders on bar close” açılabilir; canlıda genelde gerçekçi değildir.

// ─── 2–3) Komisyon / slippage ───────────────────────────────────────────────
// commission_value = 0.075 (%), slippage = 2 tick — strategy() declaration.
// Farklı maliyet senaryoları: Properties veya dosyadaki değerleri değiştirip yeniden test edin.
// Küçük maliyetle bozulan sistem gerçek sürtünmeye de hassastır.

// ─── 4) Repaint / lookahead ─────────────────────────────────────────────────
grpRepaint = "4 · Repaint / Lookahead"
useHtfFilter = input.bool(true, "Üst TF trend filtresi", group=grpRepaint)
htfTf        = input.timeframe("60", "Üst timeframe", group=grpRepaint)
htfMaLen     = input.int(50, "Üst TF MA uzunluğu", minval=5, group=grpRepaint)

f_htfClose() =>
    request.security(syminfo.tickerid, htfTf, close, lookahead=barmerge.lookahead_off)

f_htfMa() =>
    request.security(syminfo.tickerid, htfTf, ta.sma(close, htfMaLen), lookahead=barmerge.lookahead_off)

// ─── 5) Pozisyon boyutu ve risk ─────────────────────────────────────────────
grpRisk = "5 · Risk / Pozisyon"
riskPctOfEquity = input.float(1.0, "İşlem başına risk (% equity)", minval=0.1, maxval=10.0, step=0.1, group=grpRisk)
atrLen          = input.int(14, "ATR uzunluğu", minval=1, group=grpRisk)
atrStopMult     = input.float(1.5, "Stop mesafesi (ATR x)", minval=0.5, step=0.1, group=grpRisk)
rrTarget        = input.float(2.0, "Hedef R:R", minval=0.5, step=0.1, group=grpRisk)
allowShort      = input.bool(true, "Short işlemlerine izin ver", group=grpRisk)

// ─── 6) Sağlamlık — yakın parametre bölgesi ─────────────────────────────────
// Tek “optimum” değer yerine yakın MA uzunluklarında benzer davranış beklenir.
grpSignal = "6 · Sinyal (sağlamlık)"
fastLen = input.int(20, "Hızlı MA", minval=2, group=grpSignal)
slowLen = input.int(50, "Yavaş MA", minval=3, group=grpSignal)
src     = input.source(close, "Kaynak", group=grpSignal)

// ─── 7) Forward test ────────────────────────────────────────────────────────
grpFwd = "7 · Forward Test"
enableAlerts = input.bool(true, "Alert üret", group=grpFwd)
showInfo     = input.bool(true, "Bilgi tablosu", group=grpFwd)

// ─── Hesaplamalar ───────────────────────────────────────────────────────────
float fastMa = ta.sma(src, fastLen)
float slowMa = ta.sma(src, slowLen)
float atr    = ta.atr(atrLen)

float htfClose = useHtfFilter ? f_htfClose() : src
float htfMa    = useHtfFilter ? f_htfMa() : slowMa
bool  htfBull  = not useHtfFilter or (htfClose > htfMa)
bool  htfBear  = not useHtfFilter or (htfClose < htfMa)

bool barOk = not useConfirmed or barstate.isconfirmed

bool longSignal  = barOk and ta.crossover(fastMa, slowMa) and htfBull
bool shortSignal = barOk and allowShort and ta.crossunder(fastMa, slowMa) and htfBear

float stopDist = atr * atrStopMult
float riskCash = strategy.equity * (riskPctOfEquity / 100.0)

f_qty(float stopDistance) =>
    float dist = math.max(stopDistance, syminfo.mintick)
    float raw  = riskCash / dist
    math.max(raw, 0.0)

// Varsayılan fill: sinyal kapanışında emir oluşur → broker emulator sonraki açılışta doldurur.
if longSignal and not na(stopDist) and stopDist > 0
    float entryPx = close
    float qty     = f_qty(stopDist)
    float sl      = entryPx - stopDist
    float tp      = entryPx + stopDist * rrTarget
    strategy.entry("Long", strategy.long, qty=qty, comment="L")
    strategy.exit("XL", "Long", stop=sl, limit=tp)
    if enableAlerts
        alert("PS6-RBT LONG | " + syminfo.ticker + " | TF=" + timeframe.period + " | approxEntry=" + str.tostring(entryPx, format.mintick) + " | SL=" + str.tostring(sl, format.mintick) + " | TP=" + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

if shortSignal and not na(stopDist) and stopDist > 0
    float entryPx = close
    float qty     = f_qty(stopDist)
    float sl      = entryPx + stopDist
    float tp      = entryPx - stopDist * rrTarget
    strategy.entry("Short", strategy.short, qty=qty, comment="S")
    strategy.exit("XS", "Short", stop=sl, limit=tp)
    if enableAlerts
        alert("PS6-RBT SHORT | " + syminfo.ticker + " | TF=" + timeframe.period + " | approxEntry=" + str.tostring(entryPx, format.mintick) + " | SL=" + str.tostring(sl, format.mintick) + " | TP=" + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

// ─── Görsel ─────────────────────────────────────────────────────────────────
plot(fastMa, "Hızlı MA", color=color.new(color.teal, 0), linewidth=2)
plot(slowMa, "Yavaş MA", color=color.new(color.orange, 0), linewidth=2)
plotshape(longSignal,  title="Long",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.teal, 0),   size=size.tiny)
plotshape(shortSignal, title="Short", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny)

alertcondition(longSignal,  title="PS6-RBT Long",  message="PS6-RBT Long sinyali — forward test / paper trading için")
alertcondition(shortSignal, title="PS6-RBT Short", message="PS6-RBT Short sinyali — forward test / paper trading için")

// ─── Bilgi tablosu (Strategy Tester metriklerini yorumlamak için) ───────────
var table info = table.new(position.bottom_right, 2, 8, bgcolor=color.new(color.black, 80), border_width=1)
if showInfo and barstate.islast
    table.cell(info, 0, 0, "Metrik", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 0, "Değer", text_color=color.gray, text_size=size.small)
    table.cell(info, 0, 1, "Equity", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(strategy.equity, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(info, 0, 2, "Net kâr", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(strategy.netprofit, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(info, 0, 3, "Max DD", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, str.tostring(strategy.max_drawdown, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(info, 0, 4, "İşlem #", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.small)
    table.cell(info, 0, 5, "Açık poz.", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, str.tostring(strategy.position_size), text_color=color.white, text_size=size.small)
    table.cell(info, 0, 6, "Risk/işlem", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 6, str.tostring(riskPctOfEquity, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 7, "Fill modeli", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 7, "next open*", text_color=color.white, text_size=size.small)
